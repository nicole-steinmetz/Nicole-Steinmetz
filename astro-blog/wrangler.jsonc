{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nicolesteinmetz-blog-trial",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nicolesteinmetz-blog-trial",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "nicolesteinmetz-blog-trial-media",
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	"triggers": {
		"crons": ["* * * * *"],
	},
}
